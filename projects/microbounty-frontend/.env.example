# ─────────────────────────────────────────────────────
# MicroBounty — Environment Variables
# ─────────────────────────────────────────────────────
# Copy this to .env and fill in your values
# cp .env.example .env
# ─────────────────────────────────────────────────────

# Supabase (Frontend — exposed to browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase (Backend only — NEVER expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Edge Function secrets (Backend only — NEVER use a VITE_ prefix)
# Set these in the Supabase dashboard: Edge Functions → Secrets. Do not put real values here.
# TINYFISH_API_KEY=your-tinyfish-api-key
# OPENROUTER_API_KEY=your-openrouter-api-key

# Algorand
VITE_APP_ID=your-algorand-app-id
VITE_NETWORK=testnet

# Algorand Node (already in your existing .env)
VITE_ALGOD_TOKEN=
VITE_ALGOD_SERVER=https://testnet-api.4160.nodely.dev
VITE_ALGOD_PORT=443
VITE_ALGOD_NETWORK=testnet

# Indexer
VITE_INDEXER_TOKEN=
VITE_INDEXER_SERVER=https://testnet-idx.4160.nodely.dev
VITE_INDEXER_PORT=443
